{
  "permissions": {
    "deny": [
      "NotebookEdit",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterPlanMode",
      "ExitPlanMode",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Claude Code needs your input\"' | { read -r m; notify-send -a 'Claude Code' 'Claude Code' \"$m\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "npx ccstatusline@latest"
  },
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  }
}

#!/usr/bin/env bash
set -euo pipefail

echo "== Installing PulseAudio and utilities =="
sudo apt update
sudo apt install -y pulseaudio pulseaudio-utils alsa-utils

echo "== Enabling PulseAudio user services =="
systemctl --user enable pulseaudio.service
systemctl --user enable pulseaudio.socket

echo "== Cleaning stale PulseAudio state (safe) =="
pulseaudio --kill 2>/dev/null || true
rm -rf "$HOME/.config/pulse"
rm -rf "/run/user/$(id -u)/pulse"

echo "== Starting PulseAudio =="
pulseaudio --start
sleep 2

echo "== Verifying PulseAudio status =="
if pulseaudio --check; then
    echo "PulseAudio is running."
else
    echo "ERROR: PulseAudio failed to start."
    exit 1
fi

echo "== Listing available sinks =="
pactl list short sinks || true

echo ""
echo "Setup complete."

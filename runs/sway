#!/usr/bin/env bash
set -euo pipefail

# Update package list and upgrade existing packages
echo "Updating system..."
sudo apt update
sudo apt upgrade -y

# Install required dependencies for Sway
echo "Installing Sway and dependencies..."
sudo apt install -y \
    sway \
    swaybg \
    swayidle \
    swaylock \
    foot \
    mako \
    grim \
    slurp \
    thunar \
    wlsunset \
    pavucontrol \
    brightnessctl \
    curl \
    vim \
    build-essential

# Optional: Set Sway as default for login (for GDM / SDDM)
echo "Sway installation complete!"
echo "You can start Sway by typing 'sway' in a TTY or set it as your session in your display manager."
